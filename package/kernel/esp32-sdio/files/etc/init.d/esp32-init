#!/bin/sh /etc/rc.common

. /lib/functions/bos-defaults.sh
. /lib/functions/esp32-wifi.sh

USE_PROCD=1

START=13
STOP=99

APP=/usr/bin/esp32-fw-log
FORCE_PARAM="--force-ng"

# Interface names without number since those can change
FG_INTF="ethap"
NG_INTF="wlan"

flash_firmware_local() {
    if ! is_factory_default || [ "$1" == "${FORCE_PARAM}" ]; then
        # It's NOT in factory default state, configure STA mode
        logger -t esp32-wifi "Loading NG firmware"
        flash_ng_firmware
        modprobe esp32-sdio
        
    else
        # It's in factory default state, configure AP mode
        logger -t esp32-wifi "Loading FG firmware"
        flash_fg_firmware
        modprobe esp32-sdio-fg
    fi
}

boot() {
    flash_firmware_local
    start "$@"
}

start_service() {
    procd_open_instance
    procd_set_param command "$APP" "$ESP32_UART_PATH" "115200"
    procd_set_param respawn 3600 5 1
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/esp32-log.pid
    procd_close_instance
}

reload_service()
{
    stop
    rmmod esp32-sdio &>/dev/null || true
    flash_firmware_local "$@"
    start "$@"
}

extra_command "reload_await" "Reload and wait for the device to appear"

reload_await() {
    local max_wait=10

    reload_service "$@"

    local watch_intf
    if ! is_factory_default || [ "$1" == "${FORCE_PARAM}" ]; then
        watch_intf="$NG_INTF"
    else
        watch_intf="$FG_INTF"
    fi

    local wait_counter=0
    while ! grep -q "$watch_intf" /proc/net/dev && [ $wait_counter -le $max_wait ]; do
        echo "Waiting for the device $watch_intf"
        sleep 1
        wait_counter=$(( $wait_counter + 1 ))
    done

    if grep -q "$watch_intf" /proc/net/dev; then
        echo "Device $watch_intf found"
        return 0
    else
        echo "Device $watch_intf NOT found"
        return 1
   fi
}
