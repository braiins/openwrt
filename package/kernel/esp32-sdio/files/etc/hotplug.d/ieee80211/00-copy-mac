. /lib/functions/bos-defaults.sh

if [ "${ACTION}" == "add" ]; then
	VENDOR_ID=$(cat /sys/${DEVPATH}/device/vendor)
	DEVICE_ID=$(cat /sys/${DEVPATH}/device/device)

	if [ "${VENDOR_ID}" = "0x0092" ] && [ "${DEVICE_ID}" == "0x6666" ]; then
		MAC=$(wifi_mac)
		logger -t hotplug "Setting MAC ${MAC} for device ${DEVICENAME}"
		echo ${MAC} > /sys/${DEVPATH}/macaddress
	fi
fi

