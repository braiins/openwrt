. /lib/functions/bos-defaults.sh
. /lib/functions/esp32-wifi.sh
. /lib/functions/bos-factory-default.sh

WATCH_DEVICE="eth0"

if is_factory_default; then
    # Device is in factory default state and ethernet just got up and has an ip address so turn off the wifi
    if [ "${ACTION}" = "ifup" ] && [ "${DEVICE}" == "${WATCH_DEVICE}" ] && [ "${INTERFACE}" == "${FACTORY_DEFAULT_ETH_INTF_NAME}" ]; then
        logger -t iface-hotplug "Address acquired on ${FACTORY_DEFAULT_ETH_INTF_NAME}, disabling hotspot"
        stop_wifi_ap
    fi

    # Device is in factory default state and ethernet was just disconnected, bring up hotspot again
    # NOTE: ifup hotplug event doesn't contain the DEVICE variable so we can't depend on it here
    if [ "${ACTION}" = "ifdown" ] && [ "${INTERFACE}" == "${FACTORY_DEFAULT_ETH_INTF_NAME}" ]; then
        logger -t iface-hotplug "Interface ${FACTORY_DEFAULT_ETH_INTF_NAME} goes down enabling hotspot"
        start_wifi_ap "$(default_ssid)"
    fi
fi
