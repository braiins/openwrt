. /lib/functions/bos-defaults.sh
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

# To ensure backward compatibility, we need to have the ethernet interface named as "lan".
# Unfortunately "lan" interface name triggers a code branch in the "config_generate" script,
# which will always create a bridge for that interface (which is something we don't want).
# To workaround it while still using the ucidef functions/board.json/config_generate apparatus,
# we temporarily name the interface as "lan_temp" and strip the "_temp" suffix in
# the uci-defaults script.
ETH_INTF_NAME="lan_temp"

board=$(bos_platform)

board_config_update

case "$board" in
	stm32mp157c-ii2-bmm1)
		. /lib/functions/bos-factory-default.sh

		# Prepare wifi interface
		ucidef_set_interface "$FACTORY_DEFAULT_AP_INTF_NAME" device "ethap0" protocol "static" ipaddr "$FACTORY_DEFAULT_AP_IP_ADDR" netmask "$FACTORY_DEFAULT_AP_IP_MASK"

		# Prepare Ethernet interface
		ucidef_set_interface "$ETH_INTF_NAME" device "eth0" protocol dhcp
		;;
	*)
		ucidef_set_interface "$ETH_INTF_NAME" device "eth0" protocol dhcp
		;;
esac

board_config_flush

exit 0
