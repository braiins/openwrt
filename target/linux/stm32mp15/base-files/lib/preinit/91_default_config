#!/bin/sh

FW_ENV_CONFIG_PATH="/etc/fw_env.config"

log_default_config() {
    echo "default-config: $1" > /dev/kmsg
}

_config_bos_mode() {
	local bos_mode_old=$(cat "$BOS_MODE_PATH" 2>/dev/null)
	local bos_mode_new=""

	case "$BOARD_NAME" in
	$BRAIINS_BOARD_stm32mp157c_ii1_am2)
		local boot_instance=$(
			sed -n "s/root=\/dev\/mmcblk\(.*\)p. .*/\1/pg" /proc/cmdline
		)
		case "$boot_instance" in
			0) bos_mode_new="emmc";;
			1) bos_mode_new="sd";;
		esac
	  ;;
	esac

	if [ -z "$bos_mode_new" ]; then
		log_default_config "bos_mode: Unexpected root device!"
		rm -f "$BOS_MODE_PATH"
	elif [ "$bos_mode_old" != "$bos_mode_new" ]; then
		log_default_config "bos_mode: Updating mode to '$bos_mode_new'"
		mkdir -p "$(dirname '$BOS_MODE_PATH')"
		echo "$bos_mode_new" > "$BOS_MODE_PATH"
	fi

	return 0
}

_config_miner_hwid() {
	local miner_hwid=$(
		dd if="$NVMEM_PATH" bs=$NVMEM_WORD_SIZE \
			skip=$NVMEM_OTP_MINER_HWID \
			count=3 2>/dev/null \
		| base64
	)

	if [ -z "$miner_hwid" ]; then
		log_default_config "miner_hwid: Cannot read OTP memory!"
		miner_hwid=$(
			dd if=/dev/urandom bs=1 count=12 2>/dev/null \
			| base64 \
			| tr "+/" "ab"
		)
	fi

	log_default_config "miner_hwid: $miner_hwid"
	echo "$miner_hwid" > "$MINER_HWID_PATH"
	return 0
}

_config_bos_platform() {
	local bos_platform_old=$(cat "$BOS_PLATFORM_PATH" 2>/dev/null)
	local bos_platform_new=${BOARD_NAME#*,}

	if [ -z "$bos_platform_new" ]; then
		log_default_config "bos_platform: Cannot parse board name!"
		rm -f "$BOS_PLATFORM_PATH"
	elif [ "$bos_platform_old" != "$bos_platform_new" ]; then
		log_default_config "bos_platform: Updating name to '$bos_platform_new'"
		mkdir -p "$(dirname '$BOS_PLATFORM_PATH')"
		echo "$bos_platform_new" > "$BOS_PLATFORM_PATH"
	fi

	return 0
}

_config_fw_env() {
	log_default_config "Creating $FW_ENV_CONFIG_PATH"

	local root_dev=$(sed "s/root=\(.*\)p. .*/\1/g" /proc/cmdline)
	local fip_dev=$(blkid --match-token PARTLABEL="$PART_NAME_FIP" \
			--output device ${root_dev}p*)

	if [ -z "$fip_dev" ]; then
		log_default_config "Partition 'fip' cannot be found!"
		# Generate default config with disabled device when FIP partition
		# cannot be found
		fip_dev="#/dev/mmcblk0p1"
	fi

	cat > "$FW_ENV_CONFIG_PATH" <<-END
		# Configuration file for fw_(printenv/saveenv) utility.
		# Up to two entries are valid, in this case the redundant
		# environment sector is assumed present.

		# MMC device name   Device offset   Env. size
		${fip_dev}      -0x4000         0x2000
		${fip_dev}      -0x2000         0x2000
	END

	return 0
}

default_config() {
	. /lib/functions/bos-defaults.sh

	_config_bos_mode
	_config_miner_hwid
	_config_bos_platform

	# generate only if 'fw_env.config' does not exist
	[ -e "$FW_ENV_CONFIG_PATH" ] || _config_fw_env

	return 0
}

boot_hook_add preinit_main default_config
